      "source": [
        "def f(row):\n",
        "\n",
        "    '''This function returns sentiment value based on the overall ratings from the user'''\n",
        "\n",
        "    if row['score'] < 3:\n",
        "        val = 'Negative'\n",
        "    elif row['score'] > 3:\n",
        "        val = 'Positive'\n",
        "    else:\n",
        "        val = 'Neutral'\n",
        "\n",
        "    return val"
      ],
      "metadata": {
        "id": "tZnrGDDghVkg"
      },
      "execution_count": null,
      "outputs": []
    },
