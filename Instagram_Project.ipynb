        "# Translate the emojies\n",
        "!pip install emoji\n",
        "\n",
        "import re\n",
        "import emoji\n",
        "\n",
        "def emojis_to_text(text):\n",
        "    if not isinstance(text, str):\n",
        "        return text\n",
        "    text = emoji.demojize(text)\n",
        "\n",
        "    # Remove colons\n",
        "    text = re.sub(r':', '', text)\n",
        "\n",
        "    # Replace underscores & hyphens with spaces\n",
        "    text = re.sub(r'[_\\-]', ' ', text)\n",
        "    return text"
      ],
      "metadata": {
