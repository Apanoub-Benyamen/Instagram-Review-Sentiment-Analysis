        "from sklearn.utils import class_weight\n",
        "import numpy as np\n",
        "from tensorflow.keras.callbacks import EarlyStopping\n",
        "\n",
        "# 1. Setup Early Stopping\n",
        "early_stop = EarlyStopping(\n",
        "    monitor='val_accuracy',\n",
        "    patience=3,\n",
        "    restore_best_weights=True\n",
        ")\n",
        "\n",
        "\n",
        "optimizer = Adam(learning_rate=0.0005)\n",
        "\n",
        "# 2. Re-compile (Reset the model memory)\n",
        "lstm_model_1.compile(\n",
        "    optimizer=optimizer,\n",
        "    loss='categorical_crossentropy',\n",
        "    metrics=['accuracy']\n",
        ")\n",
        "\n",
        "# 3. Define Manual (Softer) Weights\n",
        "# We give it a gentle nudge.\n",
        "# 0 (Negative): 2x importance\n",
        "# 1 (Neutral):  3x importance (instead of 8.5x)\n",
        "# 2 (Positive): 1x importance\n",
        "soft_weights = {0: 2.0, 1: 3.0, 2: 1.0}\n",
        "\n",
        "# 4. Train\n",
        "history1 = lstm_model_1.fit(\n",
        "    X_train,\n",
        "    y_train,\n",
        "    epochs=15,\n",
        "    batch_size=32,\n",
        "    validation_split=0.1,\n",
        "    callbacks=[early_stop],\n",
        "    class_weight=soft_weights  # Use our manual, safer weights\n",
        ")\n",
        "\n",
        "loss, acc = lstm_model_1.evaluate(X_test, y_test)\n",
        "print(\"LSTM Accuracy:\", acc)"
      ],
