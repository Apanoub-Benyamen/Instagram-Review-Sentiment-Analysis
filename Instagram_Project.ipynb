    {
      "cell_type": "code",
      "source": [
        "from deep_translator import GoogleTranslator\n",
        "from tqdm import tqdm\n",
        "import os\n",
        "import time\n",
        "\n",
        "# 1. Setup Translator\n",
        "translator = GoogleTranslator(source='auto', target='en')\n",
        "\n",
        "def translate_review(text):\n",
        "    try:\n",
        "        if not isinstance(text, str):\n",
        "            return str(text)\n",
        "        return translator.translate(text)\n",
        "    except:\n",
        "        return text\n",
        "\n",
        "checkpoint_file = \"translated_reviews.csv\"\n",
        "save_every = 50  # Save every 50 rows\n",
        "\n",
        "# 2. Smart Resume Logic\n",
        "# Ensure the column exists in your current dataframe\n",
        "if \"translated_review\" not in df_reviews.columns:\n",
        "    df_reviews[\"translated_review\"] = None\n",
        "\n",
        "# If a checkpoint file exists, load it and fill in the gaps\n",
        "if os.path.exists(checkpoint_file):\n",
        "    print(\"🔄 Found checkpoint file. Merging progress...\")\n",
        "    try:\n",
        "        # Load the saved file\n",
        "        df_checkpoint = pd.read_csv(checkpoint_file)\n",
        "\n",
        "        # Check if row counts match to ensure safe merging\n",
        "        if len(df_checkpoint) == len(df_reviews):\n",
        "            # We copy ONLY the 'translated_review' column from the file to our main dataframe\n",
        "            df_reviews[\"translated_review\"] = df_checkpoint[\"translated_review\"]\n",
        "\n",
        "            # Calculate how many are actually done\n",
        "            num_done = df_reviews[\"translated_review\"].notna().sum()\n",
        "            print(f\"✅ Successfully loaded {num_done} translated reviews.\")\n",
        "            print(f\"   Remaining to translate: {len(df_reviews) - num_done}\")\n",
        "        else:\n",
        "            print(\"⚠️ Checkpoint file has different number of rows than current data. Starting fresh to avoid mismatch.\")\n",
        "    except Exception as e:\n",
        "        print(f\"⚠️ Error reading checkpoint: {e}. Starting fresh.\")\n",
        "else:\n",
        "    print(\"🆕 No checkpoint found. Starting from scratch.\")\n",
        "\n",
        "# 3. Processing Loop\n",
        "print(\"Starting translation loop...\")\n",
        "\n",
        "for i, idx in enumerate(tqdm(df_reviews.index, total=len(df_reviews))):\n",
        "    # Check if we already have a translation for this row\n",
        "    if pd.isna(df_reviews.loc[idx, \"translated_review\"]):\n",
        "\n",
        "        # Get the cleaned text\n",
        "        text_source = df_reviews.loc[idx, \"content_without_emojis\"]\n",
        "\n",
        "        # Translate\n",
        "        df_reviews.loc[idx, \"translated_review\"] = translate_review(text_source)\n",
        "\n",
        "        # Small delay to prevent Google ban\n",
        "        time.sleep(0.2)\n",
        "\n",
        "        # Save in batches (only when we actually do work)\n",
        "        # We use 'i' which is the loop counter\n",
        "        if i % save_every == 0:\n",
        "            df_reviews.to_csv(checkpoint_file, index=False)\n",
        "\n",
        "# 4. Final Save\n",
        "df_reviews.to_csv(checkpoint_file, index=False)\n",
        "print(\"🎉 Translation complete and saved!\")"
      ],
