    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def generate_pie_chart(df):\n",
        "    sentiment_counts = df['vader_Sentiment'].value_counts()\n",
        "    colors = ['#fee8c8','#fdbb84','#e34a33','#238b45'] # You can adjust the color according to the number of categories\n",
        "    plt.figure(figsize=(8, 6))\n",
        "    wedges, texts, autotexts = plt.pie(\n",
        "        sentiment_counts,\n",
        "        labels=sentiment_counts.index,\n",
        "        autopct='%1.1f%%',\n",
        "        startangle=140,\n",
        "        colors=colors,\n",
        "        textprops={'fontsize': 26}  #Set the font size of the labels and percentages\n",
        "    )\n",
        "    plt.setp(autotexts, size=24, weight=\"bold\")  # The percentage text is bolded\n",
        "    plt.axis('equal')  # Keep the pie chart round\n",
        "    # plt.title('Sentiment Distribution', fontsize=20)\n",
        "    plt.savefig('pie_chart_Instagram.jpg')\n",
        "    plt.show()\n",
        "\n",
        "generate_pie_chart(df_reviews_vader_sentiment)"
      ],
      "metadata": {
