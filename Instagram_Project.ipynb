      "cell_type": "code",
      "source": [
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Embedding, LSTM, Dense, Dropout, Bidirectional\n",
        "from tensorflow.keras.optimizers import Adam\n",
        "\n",
        "# Enhanced Model Structure\n",
        "lstm_model_1 = Sequential([\n",
        "    # 1. Embedding Layer (Same as before)\n",
        "    Embedding(input_dim=10000, output_dim=128, input_length=100),\n",
        "\n",
        "    # 2. Bidirectional LSTM (Reads text both ways) + Dropout (Prevents memorizing)\n",
        "    Bidirectional(LSTM(64, return_sequences=False)), # 64 units is often enough for simple text\n",
        "    Dropout(0.5), # Drops 50% of neurons randomly during training to force learning\n",
        "\n",
        "    # 3. Dense Layer with Dropout\n",
        "    Dense(32, activation='relu'),\n",
        "    Dropout(0.5),\n",
        "\n",
        "    # 4. Output Layer\n",
        "    Dense(3, activation='softmax')\n",
        "])\n",
        "\n",
        "# Use a lower learning rate for better stability\n",
        "optimizer = Adam(learning_rate=0.001)\n",
        "\n",
        "lstm_model_1.compile(\n",
        "    optimizer=optimizer,\n",
        "    loss='categorical_crossentropy',\n",
        "    metrics=['accuracy']\n",
        ")\n",
        "\n",
        "lstm_model_1.summary()"
      ],
