    {
      "cell_type": "code",
      "source": [
        "from wordcloud import WordCloud\n",
        "\n",
        "def plot_word_clouds(df):\n",
        "    # Separate text by sentiment\n",
        "    pos_text = \" \".join(df[df['vader_Sentiment'] == 'Positive']['content_cleaned'].astype(str))\n",
        "    neg_text = \" \".join(df[df['vader_Sentiment'] == 'Negative']['content_cleaned'].astype(str))\n",
        "\n",
        "    # Create WordClouds\n",
        "    wc_pos = WordCloud(width=800, height=400, background_color='white', colormap='Greens').generate(pos_text)\n",
        "    wc_neg = WordCloud(width=800, height=400, background_color='white', colormap='Reds').generate(neg_text)\n",
        "\n",
        "    # Plot\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(16, 8))\n",
        "\n",
        "    axes[0].imshow(wc_pos, interpolation='bilinear')\n",
        "    axes[0].set_title('Most Frequent Words in POSITIVE Reviews', fontsize=16)\n",
        "    axes[0].axis('off')\n",
        "\n",
        "    axes[1].imshow(wc_neg, interpolation='bilinear')\n",
        "    axes[1].set_title('Most Frequent Words in NEGATIVE Reviews', fontsize=16)\n",
        "    axes[1].axis('off')\n",
        "\n",
        "    plt.show()\n",
        "plot_word_clouds(df_reviews_vader_sentiment)"
      ],
